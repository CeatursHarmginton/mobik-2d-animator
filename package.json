{
  "name": "mobik-animator",
  "version": "1.0.0",
  "description": "Professional 2D Animation Editor for game/app development pipelines",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "tsc && npm run copy-static",
    "copy-static": "powershell -Command \"New-Item -ItemType Directory -Force -Path dist/renderer/styles | Out-Null; Copy-Item src/renderer/index.html dist/renderer/; Copy-Item src/renderer/styles/* dist/renderer/styles/\"",
    "dev": "tsc -w & electron .",
    "package": "electron-builder",
    "test": "jest"
  },
  "author": "Mobik Studio",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "typescript": "^5.3.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0"
  },
  "dependencies": {
    "msgpackr": "^1.10.0"
  },
  "build": {
    "appId": "com.mobik.animator",
    "productName": "Mobik Animator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}